# Copy to .env.local. Nothing here is needed for `npm test` or the local panel
# (PGLITE_DIR=.pglite SOBA_DRY_RUN=1 npm run dev).

APP_URL=https://app.usesoba.com
DATABASE_URL=postgres://...            # unset = embedded PGlite in PGLITE_DIR
SESSION_SECRET=change-me               # signs the panel and admin cookies
ADMIN_TOKEN=change-me                  # /admin?key=<ADMIN_TOKEN>

ANTHROPIC_API_KEY=sk-ant-...           # every LLM step; SOBA_MODEL overrides claude-opus-5-5

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+1...    # our one WhatsApp business number
TWILIO_TEMPLATE_CARD=HX...             # approved Content templates (see agents/README.md)
TWILIO_TEMPLATE_CARD_NON_ORDER=HX...
TWILIO_TEMPLATE_NOTICE=HX...
TWILIO_TEMPLATE_SAME_PRICES=HX...

ELEVENLABS_API_KEY=...
ELEVENLABS_WEBHOOK_SECRET=...          # post-call webhook signing secret
ELEVENLABS_TOOL_SECRET=...             # x-soba-tool-secret header on the mid-call tool
ELEVENLABS_CALLBACK_AGENT_ID=...       # the agent that calls buyers back

RESEND_API_KEY=re_...
EMAIL_FROM="Soba <desk@usesoba.com>"

INNGEST_EVENT_KEY=...                  # unset = events are buffered, timers don't run
INNGEST_SIGNING_KEY=...

# Dev switches
# SOBA_DRY_RUN=1            log outbound messages and calls instead of sending
# SOBA_SKIP_SIGNATURES=1    accept unsigned webhooks (local curl testing only)
# PGLITE_DIR=.pglite        persist the embedded database between runs
